# App
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database (conexión MySQL directa, vía mysql2)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=corbana_sanitario
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# JWT
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Integraciones
# URL base del API de api-rest-banarica (Logística), usada para sincronizar
# sus almacenes activos como fincas de corbana y su Programación de Corte.
# Estos dos valores son solo el default: lo normal es configurarlos desde
# Configuración → Conexión con Logística (guardado en la tabla
# `configuraciones`, ver configuracion.service.js), que tiene prioridad.
BANARICA_API_URL=https://api-logistica-banarica.vercel.app
BANARICA_API_KEY=
# En espejo de BANARICA_API_KEY pero en sentido inverso: la key que
# api-rest-banarica debe mandar por header `api` al llamar a
# POST /programacion-corte/webhook-sync-banarica (avisa que ya cargó una
# semana). Generá algo aleatorio y largo, y configurá el mismo valor allá
# como CORBANA_API_KEY / CORBANA_API_URL.
CORBANA_API_KEY=
APP_URL=https://app-corbana.vercel.app/

# CORS
CORS_ORIGIN=*

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Seed admin user
ADMIN_USUARIO=admin
ADMIN_EMAIL=admin@corbana.com
ADMIN_PASSWORD="Admin#12345"
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDO=Sistema

# Clave dedicada para que el script app-movil/scripts/publish-version.mjs
# pueda actualizar PUT /configuraciones/app-version sin usar una cuenta de
# usuario real. Generá algo aleatorio y largo, no una contraseña que uses en
# otro lado.
APP_VERSION_DEPLOY_KEY=

# Secreto del cron diario de Vercel que recalcula Producción Semanal (ver
# vercel.json y src/routes/sistema/cron.routes.js) — Vercel manda este
# mismo valor en el header Authorization de cada invocación programada.
# Generá algo aleatorio y largo.
CRON_SECRET=

# Fotos de Evaluación de Labores (app móvil) — subidas a Google Drive con
# una cuenta de servicio, mismo patrón que api-rest-banarica.
# GOOGLE_DRIVE_CREDENTIALS: el JSON completo de la cuenta de servicio, como
# UNA sola línea (string). GOOGLE_DRIVE_FOLDER_LABORES: ID de una carpeta
# dentro de una unidad compartida (Shared Drive) de Google, con la cuenta de
# servicio agregada como "Administrador de contenido" — las cuentas de
# servicio no tienen cuota propia en "Mi unidad", tiene que ser compartida.
GOOGLE_DRIVE_CREDENTIALS=
GOOGLE_DRIVE_FOLDER_LABORES=


