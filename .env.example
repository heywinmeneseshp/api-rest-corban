# App
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database
# DB_MODE=direct   -> MySQL directo (mysql2). Uso normal en desarrollo local
#                     o en un hosting/VPS que permite conexiones externas al 3306.
# DB_MODE=bridge   -> Túnel HTTP hacia tunnel.php en un hosting compartido que
#                     SOLO acepta conexiones MySQL desde localhost.
#                     Requiere desplegar hosting-tunnel/ primero (ver su README)
#                     y llenar BRIDGE_URL / BRIDGE_API_KEY abajo.
DB_MODE=direct
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=corbana_sanitario
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# Solo si DB_MODE=bridge:
BRIDGE_URL=
BRIDGE_API_KEY=BanaRica2026-*Corbana&%2026-

# JWT
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Integraciones
# URL base del API de api-rest-banarica, usada para sincronizar sus
# almacenes activos como fincas de corbana (POST /fincas/sync-banarica).
BANARICA_API_URL=https://api-logistica-banarica.vercel.app
APP_URL=https://app-corbana.vercel.app/

# CORS
CORS_ORIGIN=*

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Seed admin user
ADMIN_USUARIO=admin
ADMIN_EMAIL=admin@corbana.com
ADMIN_PASSWORD="Admin#12345"
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDO=Sistema

# Clave dedicada para que el script app-movil/scripts/publish-version.mjs
# pueda actualizar PUT /configuraciones/app-version sin usar una cuenta de
# usuario real. Generá algo aleatorio y largo, no una contraseña que uses en
# otro lado.
APP_VERSION_DEPLOY_KEY=


