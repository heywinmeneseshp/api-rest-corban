# App
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database (conexión MySQL directa, vía mysql2)
DB_HOST=host3.latinoamericahosting.com
DB_PORT=3306
DB_NAME=joeyropa_management
DB_USER=joeyropa_master
DB_PASSWORD=
DB_LOGGING=true


# JWT
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Integraciones con api-rest-banarica (Logística)
# URL base de su API, usada para sincronizar sus almacenes activos como
# fincas de Corbana y su Programación de Corte. Estos dos valores son solo
# el default: lo normal es configurarlos desde Configuración → Conexión con
# Logística (guardado en la tabla `configuraciones`), que tiene prioridad.
BANARICA_API_URL=https://api-logistica.banarica.cloud
BANARICA_API_KEY=
# En espejo de BANARICA_API_KEY pero en sentido inverso: la key que
# api-rest-banarica debe mandar por header `api` al llamar a
# POST /programacion-corte/webhook-sync-banarica (avisa que ya cargó una
# semana). Generá algo aleatorio y largo, y configurá el mismo valor allá
# como CORBANA_API_KEY / CORBANA_API_URL.
CORBANA_API_KEY=

# CORS
CORS_ORIGIN=*

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=10

# Usuario Administrador que crea el seeder inicial
ADMIN_USUARIO=admin
ADMIN_EMAIL=hemeneses@banarica.com
ADMIN_PASSWORD="Admin#12345"
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDO=Sistema

# Clave dedicada para que el script app-movil/scripts/publish-version.mjs
# pueda actualizar PUT /configuraciones/app-version sin usar una cuenta de
# usuario real. Generá algo aleatorio y largo, no una contraseña que uses en
# otro lado.
APP_VERSION_DEPLOY_KEY=a12dc8e02348df63af530e41afa391478d84639127a0804d8d24a2a449bd237e

# Secreto del cron diario de Vercel que recalcula Producción Semanal (ver
# vercel.json y src/routes/sistema/cron.routes.js) — Vercel manda este
# mismo valor en el header Authorization de cada invocación programada.
# Generá algo aleatorio y largo.
CRON_SECRET=

# Correo saliente: recuperación de contraseña y avisos de Sanidad Vegetal —
# Evaluación de Labores (cargue y revisión aprobada). Sin SMTP_HOST/USER/
# PASS configurados, mail.service.js no rompe: solo deja de enviar y escribe
# el contenido del correo en consola (útil en desarrollo).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=soporteapplog@gmail.com
SMTP_PASS=
SMTP_FROM=noreply@banarica.cloud


# URL pública del panel (app-corbana), usada para armar los links dentro de
# los correos que manda mail.service.js ("Ingresar al sistema", "Ver
# evaluación").
APP_URL=https://banarica.cloud

# En true, corre migraciones/seeders pendientes automáticamente al arrancar
# (ver migrationRunner.js) — pensado para Vercel, donde nadie las corre a
# mano. En desarrollo local dejar en false: nodemon reinicia el proceso en
# cada guardado, y correrlas en cada reinicio satura el túnel del hosting.
# Migrar/sembrar en local con `npm run db:migrate` / `npm run db:seed`.
AUTO_MIGRATE=false

# Evidencias (fotos) de los distintos módulos (ej. Evaluación de Labores en
# la app móvil) — subidas a Google Drive con una cuenta de servicio.
# GOOGLE_DRIVE_CREDENTIALS: el JSON completo de la cuenta de servicio, como
# UNA sola línea (string). GOOGLE_DRIVE_FOLDER: ID de la carpeta RAÍZ dentro
# de una unidad compartida (Shared Drive) de Google, con la cuenta de
# servicio agregada como "Administrador de contenido" — las cuentas de
# servicio no tienen cuota propia en "Mi unidad", tiene que ser compartida.
# Dentro de esa raíz, cada módulo crea su propia carpeta (ver
# services/googleDrive/cargueFotosLabor.js), y dentro de esa, una subcarpeta
# por cada evidencia cargada (semana_finca_fecha_formato).
GOOGLE_DRIVE_CREDENTIALS=
GOOGLE_DRIVE_FOLDER=
