{
  "name": "api-rest-corbana",
  "version": "1.0.0",
  "description": "API REST para control sanitario de banano (CORBANA)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "db:migrate": "sequelize-cli db:migrate --config src/database/cli-config.cjs --migrations-path src/database/migrations --seeders-path src/database/seeders",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config src/database/cli-config.cjs --migrations-path src/database/migrations --seeders-path src/database/seeders",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all --config src/database/cli-config.cjs --migrations-path src/database/migrations --seeders-path src/database/seeders",
    "db:seed": "sequelize-cli db:seed:all --config src/database/cli-config.cjs --migrations-path src/database/migrations --seeders-path src/database/seeders",
    "db:seed:undo": "sequelize-cli db:seed:undo:all --config src/database/cli-config.cjs --migrations-path src/database/migrations --seeders-path src/database/seeders"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "mysql2": "^3.11.0",
    "sequelize": "^6.37.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.9.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "sequelize-cli": "^6.6.2"
  }
}
